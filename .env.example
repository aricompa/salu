# Browser-safe (RLS protects data). Local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Public base URL used in QR codes and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key (public by design; invariant 6). Local and CI use Cloudflare's
# always-pass test key. The Turnstile SECRET never goes here: it lives in Supabase Auth config.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
